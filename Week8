        "\n",
        "KB = [\n",
        "    (\"American\", \"Robert\"),\n",
        "    (\"Enemy\", \"A\", \"America\"),\n",
        "    (\"Missile\", \"M1\"),\n",
        "    (\"Owns\", \"A\", \"M1\")\n",
        "]\n",
        "\n",
        "rules = [\n",
        "    ([(\"Enemy\", \"?x\", \"America\")],\n",
        "     (\"Hostile\", \"?x\")),\n",
        "\n",
        "    ([(\"Missile\", \"?x\")],\n",
        "     (\"Weapon\", \"?x\")),\n",
        "\n",
        "    ([(\"Missile\", \"?x\"), (\"Owns\", \"?y\", \"?x\")],\n",
        "     (\"Sells\", \"Robert\", \"?x\", \"?y\")),\n",
        "\n",
        "    ([(\"American\", \"?x\"), (\"Weapon\", \"?y\"),\n",
        "      (\"Sells\", \"?x\", \"?y\", \"?z\"),\n",
        "      (\"Hostile\", \"?z\")],\n",
        "     (\"Criminal\", \"?x\"))\n",
        "]\n",
        "\n",
        "def is_variable(x):\n",
        "    return isinstance(x, str) and x.startswith(\"?\")\n",
        "\n",
        "def substitute(atom, theta):\n",
        "    return tuple(theta.get(x, x) for x in atom)\n",
        "\n",
        "def unify(a, b, theta=None):\n",
        "    if theta is None:\n",
        "        theta = {}\n",
        "\n",
        "    theta = theta.copy()\n",
        "\n",
        "    for x, y in zip(a, b):\n",
        "        x = theta.get(x, x)\n",
        "        y = theta.get(y, y)\n",
        "\n",
        "        if x == y:\n",
        "            continue\n",
        "        elif is_variable(x):\n",
        "            theta[x] = y\n",
        "        elif is_variable(y):\n",
        "            theta[y] = x\n",
        "        else:\n",
        "            return None\n",
        "\n",
        "    return theta\n",
        "\n",
        "count = 0\n",
        "\n",
        "def standardize(rule):\n",
        "    global count\n",
        "    count += 1\n",
        "\n",
        "    premises, conclusion = rule\n",
        "    mapping = {}\n",
        "\n",
        "    def rename(atom):\n",
        "        result = []\n",
        "        for x in atom:\n",
        "            if is_variable(x):\n",
        "                if x not in mapping:\n",
        "                    mapping[x] = x + \"_\" + str(count)\n",
        "                result.append(mapping[x])\n",
        "            else:\n",
        "                result.append(x)\n",
        "        return tuple(result)\n",
        "\n",
        "    return [rename(p) for p in premises], rename(conclusion)\n",
        "\n",
        "def match(premises, KB, theta=None):\n",
        "    if theta is None:\n",
        "        theta = {}\n",
        "\n",
        "    if not premises:\n",
        "        return [theta]\n",
        "\n",
        "    first = substitute(premises[0], theta)\n",
        "    results = []\n",
        "\n",
        "    for fact in KB:\n",
        "        new_theta = unify(first, fact, theta)\n",
        "\n",
        "        if new_theta is not None:\n",
        "            results += match(premises[1:], KB, new_theta)\n",
        "\n",
        "    return results\n",
        "\n",
        "def forward_chaining(KB, rules, query):\n",
        "\n",
        "    KB = list(KB)\n",
        "\n",
        "    while True:\n",
        "        new = []\n",
        "\n",
        "        for rule in rules:\n",
        "            premises, conclusion = standardize(rule)\n",
        "\n",
        "            for theta in match(premises, KB):\n",
        "\n",
        "                q = substitute(conclusion, theta)\n",
        "\n",
        "                if q not in KB and q not in new:\n",
        "                    new.append(q)\n",
        "\n",
        "                    print(\"New Fact:\", q)\n",
        "\n",
        "                    if unify(query, q) is not None:\n",
        "                        print(\"\\nQuery Proved:\", query)\n",
        "                        return True\n",
        "\n",
        "        if not new:\n",
        "            break\n",
        "\n",
        "        KB.extend(new)\n",
        "\n",
        "    print(\"\\nQuery Not Proved:\", query)\n",
        "    return False\n",
        "\n",
        "query = (\"Criminal\", \"Robert\")\n",
        "\n",
        "print(\"Initial Knowledge Base:\")\n",
        "for fact in KB:\n",
        "    print(fact)\n",
        "\n",
        "print(\"\\nForward Chaining:\")\n",
        "forward_chaining(KB, rules, query)\n"
      ]
    }
