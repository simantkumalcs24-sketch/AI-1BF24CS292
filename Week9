        "\n",
        "\n",
        "\n",
        "\n",
        "KB = [\n",
        "    {\"~Food(Peanuts)\", \"Likes(John,Peanuts)\"},\n",
        "\n",
        "    {\"Food(Apple)\"},\n",
        "    {\"Food(Vegetables)\"},\n",
        "\n",
        "    {\"~Eats(Anil,Peanuts)\", \"Killed(Anil)\",\n",
        "     \"Food(Peanuts)\"},\n",
        "\n",
        "    {\"Eats(Anil,Peanuts)\"},\n",
        "    {\"Alive(Anil)\"},\n",
        "\n",
        "    {\"~Eats(Anil,Peanuts)\", \"Eats(Harry,Peanuts)\"},\n",
        "\n",
        "    {\"~Alive(Anil)\", \"~Killed(Anil)\"},\n",
        "\n",
        "    {\"Killed(Anil)\", \"Alive(Anil)\"},\n",
        "\n",
        "    {\"~Likes(John,Peanuts)\"}\n",
        "]\n",
        "\n",
        "def negate(literal):\n",
        "    if literal.startswith(\"~\"):\n",
        "        return literal[1:]\n",
        "    return \"~\" + literal\n",
        "\n",
        "def resolve(c1, c2):\n",
        "    resolvents = []\n",
        "\n",
        "    for literal in c1:\n",
        "        opposite = negate(literal)\n",
        "\n",
        "        if opposite in c2:\n",
        "            new_clause = (c1 - {literal}) | (c2 - {opposite})\n",
        "\n",
        "            if not any(negate(x) in new_clause\n",
        "                       for x in new_clause):\n",
        "                resolvents.append(new_clause)\n",
        "\n",
        "    return resolvents\n",
        "\n",
        "def resolution(KB):\n",
        "\n",
        "    clauses = list(KB)\n",
        "\n",
        "    while True:\n",
        "        new = []\n",
        "\n",
        "        for i in range(len(clauses)):\n",
        "            for j in range(i + 1, len(clauses)):\n",
        "\n",
        "                resolvents = resolve(clauses[i], clauses[j])\n",
        "\n",
        "                for clause in resolvents:\n",
        "\n",
        "                    if len(clause) == 0:\n",
        "                        print(\"\\nEmpty Clause (NIL) Found!\")\n",
        "                        print(\"Query Proved!\")\n",
        "                        return True\n",
        "\n",
        "                    if clause not in clauses and clause not in new:\n",
        "                        new.append(clause)\n",
        "                        print(\"New Clause:\", clause)\n",
        "\n",
        "        if not new:\n",
        "            print(\"\\nQuery Cannot Be Proved\")\n",
        "            return False\n",
        "\n",
        "        clauses.extend(new)\n",
        "\n",
        "\n",
        "print(\"Resolution Method:\")\n",
        "resolution(KB)\n"
      ]
